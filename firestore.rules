rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function validNote(uid) {
      let note = request.resource.data;
      return note.keys().hasAll([
          'uid', 'title', 'content', 'date', 'deleted', 'updatedAt'
        ])
        && note.keys().hasOnly([
          'uid', 'title', 'content', 'date', 'deleted', 'updatedAt', 'category',
          'checklist'
        ])
        && note.uid == uid
        && note.title is string
        && note.content is string
        && note.date is string
        && (!('category' in note) || note.category is string)
        && (!('checklist' in note) || note.checklist is list)
        && note.deleted is bool
        && note.updatedAt == request.time;
    }

    match /users/{uid}/notes/{noteId} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && validNote(uid);
      allow update: if isOwner(uid)
        && validNote(uid)
        && (!resource.data.deleted || request.resource.data.deleted);
      allow delete: if isOwner(uid);
    }
  }
}
