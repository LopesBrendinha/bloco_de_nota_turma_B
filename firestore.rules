rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    function validNote(uid) {
      let note = request.resource.data;
      return note.keys().hasOnly([
        'uid', 'title', 'content', 'category', 'createdAt', 'updatedAt',
        'archived', 'deleted', 'changeId'
      ]) && note.keys().hasAll([
        'uid', 'title', 'content', 'category', 'createdAt', 'updatedAt',
        'archived', 'deleted', 'changeId'
      ]) && note.uid == uid
        && note.title is string && note.title.size() <= 120
        && note.content is string && note.content.size() <= 20000
        && note.category is string && note.category.size() > 0
        && note.category.size() <= 40
        && note.createdAt is int && note.createdAt > 0
        && note.updatedAt is int && note.updatedAt >= note.createdAt
        && note.archived is bool && note.deleted is bool
        && note.changeId is string && note.changeId.size() == 36;
    }
    match /users/{uid}/notes/{noteId} {
      allow read: if owner(uid);
      allow create: if owner(uid) && validNote(uid);
      allow update: if owner(uid) && validNote(uid)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt >= resource.data.updatedAt;
      allow delete: if false;
    }
  }
}
